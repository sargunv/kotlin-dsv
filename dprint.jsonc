// dprint owns formatting for every language here.
{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "lineWidth": 100,
  "indentWidth": 2,
  "useTabs": false,
  "newLineKind": "lf",
  "excludes": [
    "**/build",
    "**/.gradle",
    "**/.kotlin",
    "**/.mise/locks",
    "kotlin-js-store",
    "**/*.api",
    "gradlew",
    "gradlew.bat",
    // Vendored Git submodule fixtures; format them in their own repos.
    "kotlin-dsv/src/fsTest/resources/csv-data/**",
    "kotlin-dsv/src/fsTest/resources/china-city-subway-csv/**",
  ],
  "oxc": {
    "experimentalSortImports": { "newlinesBetween": true },
    "lineWidth": 80,
    "proseWrap": "always",
    "sortPackageJson": false,
  },
  "ktfmt": { "style": "google", "lineWidth": 100 },
  // Digests are required on a bump; dprint reports the one it got.
  "plugins": [
    "npm:@dprint/oxc@0.48.0@df41021ac038f6f34e39012425eef6247573f049203f0e6541120855e1c04082",
    "https://plugins.dprint.dev/sargunv/ktfmt-0.65.0.json@d355d4440dda00c0e315b5c39669f417bcfa76b64b68591fa1818f7a1f6b1005",
  ],
}
