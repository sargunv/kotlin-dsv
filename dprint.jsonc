// dprint owns formatting for every language here.
{
    "$schema": "https://dprint.dev/schemas/v0.json",
    "lineWidth": 100,
    "indentWidth": 2,
    "useTabs": false,
    "newLineKind": "lf",
    "excludes": [
        "**/build",
        "**/.gradle",
        "**/.kotlin",
        "**/.mise/locks",
        "kotlin-js-store",
        "**/*.api",
        "gradlew",
        "gradlew.bat",
        // Vendored Git submodule fixtures; format them in their own repos.
        "kotlin-dsv/src/fsTest/resources/csv-data/**",
        "kotlin-dsv/src/fsTest/resources/china-city-subway-csv/**",
    ],
    "json": { "indentWidth": 4, "preferSingleLine": true },
    "ktfmt": { "style": "google", "lineWidth": 100 },
    "markdown": { "textWrap": "always" },
    "toml": {},
    "yaml": { "indentWidth": 4 },
    // Digests are required on a bump; dprint reports the one it got.
    "plugins": [
        "https://plugins.dprint.dev/json-0.25.2.wasm@811ca4c6f732bcd6f707bc2f42d42395bb4127cdf829960cf628a18fc149777e",
        "https://plugins.dprint.dev/markdown-0.27.1.wasm@92486ceb94205c01209e981fd860d68317a14ff2375f8b916289f2b0baded129",
        "https://plugins.dprint.dev/sargunv/ktfmt-0.65.0.json@d355d4440dda00c0e315b5c39669f417bcfa76b64b68591fa1818f7a1f6b1005",
        "https://plugins.dprint.dev/toml-0.9.0.wasm@776e088ed4255a51a80e3640e5fd20b15661147e86df3e99611aaa37e9c59852",
        "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm@40a2fdda7040317eb1b23520f3a00769a5571eedb049c4ca9175c1b9eeba01ae",
    ],
}
