// dprint owns formatting for every language here. Prefer a plugin; exec a
// mise-installed formatter only where no plugin exists.
{
    "$schema": "https://dprint.dev/schemas/v0.json",
    "lineWidth": 100,
    "indentWidth": 2,
    "useTabs": false,
    "newLineKind": "lf",
    "excludes": [
        "**/build",
        "**/.gradle",
        "**/.kotlin",
        "kotlin-js-store",
        "**/*.api",
        "gradlew",
        "gradlew.bat",
        // Vendored Git submodule fixtures; format them in their own repos.
        "kotlin-dsv/src/fsTest/resources/csv-data/**",
        "kotlin-dsv/src/fsTest/resources/china-city-subway-csv/**",
    ],
    "json": { "indentWidth": 4, "preferSingleLine": true },
    "markdown": { "textWrap": "always" },
    "toml": {},
    "yaml": { "indentWidth": 4 },
    "exec": {
        "commands": [
            {
                "command": "mise run _ktfmt --google-style - --stdin-name={{file_path}}",
                "exts": ["kt", "kts"],
            },
        ],
    },
    // Digests are required on a bump; dprint reports the one it got.
    "plugins": [
        "https://plugins.dprint.dev/exec-0.6.2.json@df98f54ffd3092b8a841aedd6d098a2651f16d0a796a40535774f1a8b4b9d463",
        "https://plugins.dprint.dev/json-0.21.3.wasm@f34c8fbaeda1f42c479d4a5fa2c86f93d105c2d527ec61fffe912e4d9dc5cc77",
        "https://plugins.dprint.dev/markdown-0.21.1.wasm@064467750514c9ce5192b375582d762ec64cb3ba99673413fa86645d50406279",
        "https://plugins.dprint.dev/toml-0.7.0.wasm@0126c8112691542d30b52a639076ecc83e07bace877638cee7c6915fd36b8629",
        "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm@40a2fdda7040317eb1b23520f3a00769a5571eedb049c4ca9175c1b9eeba01ae",
    ],
}
