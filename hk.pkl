// Drives pre-commit, `mise run check`, and `mise run fix`.
// Top-level steps create the implicit check, fix, and pre-commit hooks.

amends "package://github.com/jdx/hk/releases/download/v2.6.0/hk@2.6.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.6.0/hk@2.6.0#/Builtins.pkl"

steps {
  // Unbatched: dprint parallelizes itself, and batching oversubscribes the
  // machine badly enough that its ktfmt children hit dprint's timeout.
  ["dprint"] = (Builtins.dprint) {
    exclusive = true
  }

  ["actionlint"] {
    glob = List(".github/workflows/*.yml", ".github/workflows/*.yaml")
    check = "actionlint {{files}}"
  }

  // actionlint covers the `run:` blocks in workflows.
  ["shellcheck"] {
    glob = List("**/*.sh", ".mise/bin/*")
    check = "shellcheck {{files}}"
  }

  // linters
  ["detekt"] {
    glob = List("**/src/commonMain/kotlin/**/*.kt")
    check = "./gradlew detekt"
    exclusive = true
  }

  // generators
  ["abi-dump"] {
    glob = List("**/src/commonMain/kotlin/**/*.kt", "**/api/*.api", "**/api/*.klib.api")
    check = "./gradlew checkKotlinAbi"
    fix = "./gradlew updateKotlinAbi"
    exclusive = true
  }
}
