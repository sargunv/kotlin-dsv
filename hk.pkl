// Drives pre-commit, `mise run check`, and `mise run fix`.
// Top-level steps create the implicit check, fix, and pre-commit hooks.

amends "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Builtins.pkl"

steps {
  // Unbatched: dprint parallelizes itself.
  ["dprint"] = (Builtins.dprint) {
    exclusive = true
  }

  ["jactionlint"] = Builtins.jactionlint

  // jactionlint covers the `run:` blocks in workflows. Builtins.shellcheck
  // also matches extensionless mise helpers via shebang.
  ["shellcheck"] = Builtins.shellcheck

  // linters
  ["detekt"] {
    glob = List("**/src/commonMain/kotlin/**/*.kt")
    check = "./gradlew detekt"
    exclusive = true
  }

  // generators
  ["abi-dump"] {
    glob = List("**/src/commonMain/kotlin/**/*.kt", "**/api/*.api", "**/api/*.klib.api")
    check = "./gradlew checkKotlinAbi"
    fix = "./gradlew updateKotlinAbi"
    exclusive = true
  }
}
